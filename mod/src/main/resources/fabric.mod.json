{
  "schemaVersion": 1,
  "id": "kindredspirit",
  "version": "${version}",
  "name": "Kindred Spirit",
  "description": "A cute AI companion that floats beside you, talks with you, and never changes your world. Client-side only. She needs her brain on your computer (Kindred Spirit Setup, macOS for now), or a friend who hosts her on a LAN world: see the homepage.",
  "authors": [
    "PetitPotam"
  ],
  "contact": {
    "homepage": "https://kindred-spirit-pip.web.app/download",
    "sources": "https://github.com/PetitPotam/kindred-spirit",
    "issues": "https://github.com/PetitPotam/kindred-spirit/issues"
  },
  "license": "AGPL-3.0-only",
  "icon": "assets/kindredspirit/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.kindredspirit.KindredSpiritClient",
      "dev.kindredspirit.job.JobsDev"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  },
  "mixins": [
    "kindredspirit.mixins.json"
  ]
}
